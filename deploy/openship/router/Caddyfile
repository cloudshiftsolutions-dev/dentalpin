# Single origin for DentalPin behind the Openship edge. TLS ends at the
# VPS gateway, so this listens on plain HTTP and tells the backend the
# public scheme is https (secure cookies, absolute links).
{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges 100.64.0.0/10
	}
}

:3030 {
	encode gzip

	handle /api/* {
		reverse_proxy backend:8000 {
			# The copilot streams SSE; without this the chat looks frozen
			# until the whole turn has been generated.
			flush_interval -1
			header_up X-Forwarded-Proto https
		}
	}

	handle /health* {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000 {
			header_up X-Forwarded-Proto https
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "frame-ancestors 'self'"
		-Server
	}
}
